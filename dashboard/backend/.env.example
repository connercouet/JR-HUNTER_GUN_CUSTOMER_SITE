# ============================================================
# Hunter's Edge Dashboard - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Anthropic Claude API ---
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Google OAuth (Gmail + Calendar + Drive) ---
# Setup guide: dashboard/SETUP.md
# Create at: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# --- GitHub Personal Access Token ---
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:user, read:org
GITHUB_TOKEN=ghp_your-token-here
GITHUB_USERNAME=connercouet

# --- Server Config ---
PORT=3001
SESSION_SECRET=change-this-to-a-random-string-at-least-32-chars
FRONTEND_URL=http://localhost:3000

# --- Google OAuth Redirect ---
# For local dev, use: http://localhost:3001/api/google/callback
# For production, use your deployed backend URL
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback
